{
  "name": "@frontagent/cli",
  "version": "0.1.0",
  "description": "FrontAgent CLI - 命令行工具",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "fa": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@frontagent/core": "workspace:*",
    "@frontagent/mcp-file": "workspace:*",
    "@frontagent/mcp-memory": "workspace:*",
    "@frontagent/mcp-shell": "workspace:*",
    "@frontagent/mcp-web": "workspace:*",
    "@frontagent/runtime-node": "workspace:*",
    "@frontagent/sdd": "workspace:*",
    "@frontagent/shared": "workspace:*",
    "chalk": "^5.6.2",
    "commander": "^11.1.0",
    "ink": "^5.2.1",
    "ink-spinner": "^5.0.0",
    "ora": "^8.2.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "@types/react": "^18.3.29",
    "typescript": "^6.0.3"
  }
}
