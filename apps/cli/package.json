{
  "name": "@frontagent/cli",
  "version": "0.1.0",
  "description": "FrontAgent CLI - 命令行工具",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "fa": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@frontagent/core": "workspace:*",
    "@frontagent/shared": "workspace:*",
    "@frontagent/sdd": "workspace:*",
    "@frontagent/mcp-file": "workspace:*",
    "@frontagent/mcp-memory": "workspace:*",
    "@frontagent/mcp-web": "workspace:*",
    "@frontagent/mcp-shell": "workspace:*",
    "@frontagent/runtime-node": "workspace:*",
    "commander": "^14.0.3",
    "chalk": "^5.3.0",
    "ora": "^9.4.0",
    "ink": "^7.0.3",
    "ink-spinner": "^5.0.0",
    "react": "^19.2.6"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^19.2.15",
    "typescript": "^5.3.0"
  }
}
