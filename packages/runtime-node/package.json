{
  "name": "@frontagent/runtime-node",
  "version": "2.0.0",
  "description": "Node runtime adapter for FrontAgent CLI and VSCode extension",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@frontagent/core": "workspace:*",
    "@frontagent/shared": "workspace:*",
    "@frontagent/sdd": "workspace:*",
    "@frontagent/mcp-file": "workspace:*",
    "@frontagent/mcp-filesense": "workspace:*",
    "@frontagent/mcp-memory": "workspace:*",
    "@frontagent/mcp-web": "workspace:*",
    "@frontagent/mcp-shell": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "vitest": "^3.1.4"
  }
}
