{
  "name": "@frontagent/mcp-file",
  "version": "2.2.0",
  "description": "MCP File Adapter - 文件操作 MCP Server",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mcp-file-server": "./dist/server.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@frontagent/mcp-filesense": "workspace:*",
    "@frontagent/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "diff": "^5.2.2",
    "glob": "^10.5.0",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@types/diff": "^5.2.3",
    "@types/node": "^25.9.5",
    "typescript": "^6.0.3"
  }
}
